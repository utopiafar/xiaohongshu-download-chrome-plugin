{
  "manifest_version": 3,
  "name": "小红书笔记下载器",
  "version": "1.4.0",
  "description": "在小红书网页版保存笔记、图片/视频和评论回复，支持博主笔记批量下载",
  "permissions": ["downloads"],
  "host_permissions": ["https://*.xhscdn.com/*", "https://*.rednotecdn.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.xiaohongshu.com/*"],
      "js": ["data.js", "main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.xiaohongshu.com/*"],
      "js": ["data.js", "zip.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
